ARG BASE_IMAGE=harbor.4pd.io/hardcore-tech/vllm/vllm-openai:v0.23.0-cu129
FROM ${BASE_IMAGE}

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY=127.0.0.1,localhost

LABEL org.opencontainers.image.title="novel-manga-video-offline-a100" \
      org.opencontainers.image.description="Single-image offline novel-to-manga production runtime" \
      io.novel-manga.video-backend="MiniMax-H3-Ref2VA-ComfyUI" \
      io.novel-manga.diffusers-version="0.38.0" \
      io.novel-manga.voxcpm-version="2.0.3" \
      io.novel-manga.qwen-tts-version="0.1.1" \
      io.novel-manga.qwen-asr-version="0.0.6"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DIFFUSERS_OFFLINE=1 \
    NOVEL_OUTPUT_ROOT=/output \
    NOVEL_UPLOAD_ROOT=/output/.uploads \
    NOVEL_JOB_ROOT=/output/.jobs \
    NOVEL_PROVIDER=command \
    NOVEL_ADMISSION_MODE=production \
    NOVEL_REQUIRE_LOCAL_MODELS=1 \
    NOVEL_IMAGE_MODEL=Z-Image-Turbo+Qwen-Image-Edit-2511 \
    NOVEL_VIDEO_MODEL=MiniMax-H3-Ref2VA \
    NOVEL_LOCAL_IMAGE_PROMPT_POLICY=native-v4 \
    NOVEL_LOCAL_VISUAL_STRATEGY=keyframe \
    NOVEL_VIDEO_REQUIRES_AUDIO=1 \
    NOVEL_VIDEO_MAX_SECONDS=8 \
    NOVEL_TTS_MODEL=VoxCPM2 \
    NOVEL_TTS_BACKEND=voxcpm2 \
    NOVEL_TTS_QWEN_FALLBACK=1 \
    NOVEL_VOXCPM_VOICE_CACHE_DIR=/output/.runtime/voxcpm2-voices \
    NOVEL_PLANNER_BACKEND=command \
    NOVEL_PLANNER_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py planner" \
    NOVEL_IMAGE_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py image" \
    NOVEL_VIDEO_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py video" \
    NOVEL_TTS_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py tts" \
    NOVEL_ASR_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py asr" \
    NOVEL_ALIGN_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py align" \
    NOVEL_MODEL_LIFECYCLE_COMMAND="/opt/venvs/controller/bin/python /app/runtime/local_model_cli.py lifecycle" \
    NOVEL_TTS_NARRATION_SPEED=1.25 \
    NOVEL_TTS_DIALOGUE_SPEED=1.15 \
    NOVEL_PLANNER_MAX_TOKENS=16000 \
    NOVEL_MEDIA_WORKERS=1 \
    NOVEL_VIDEO_WORKERS=1 \
    NOVEL_MINIMAX_H3_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors \
    NOVEL_MINIMAX_H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_int8_convrot.safetensors \
    NOVEL_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors \
    NOVEL_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors \
    NOVEL_MINIMAX_H3_WIDTH=480 \
    NOVEL_MINIMAX_H3_HEIGHT=832 \
    NOVEL_MINIMAX_H3_STEPS=20 \
    NOVEL_MINIMAX_H3_SCHEDULER=simple \
    NOVEL_MINIMAX_H3_REF_IMAGE_SIZE=match \
    NOVEL_MINIMAX_H3_URL=http://127.0.0.1:18100 \
    NOVEL_MODEL_SUPERVISOR_URL=http://127.0.0.1:18090 \
    NOVEL_MODEL_WORKER_URL=http://127.0.0.1:18100

RUN sed -i \
      -e 's@http://archive.ubuntu.com/ubuntu/@https://mirrors.tuna.tsinghua.edu.cn/ubuntu/@g' \
      -e 's@http://security.ubuntu.com/ubuntu/@https://mirrors.tuna.tsinghua.edu.cn/ubuntu/@g' \
      /etc/apt/sources.list \
    && mv /etc/apt/sources.list.d/cuda-ubuntu2204-x86_64.list /etc/apt/sources.list.d/cuda-ubuntu2204-x86_64.list.disabled \
    && mv /etc/apt/sources.list.d/deadsnakes-ubuntu-ppa-jammy.list /etc/apt/sources.list.d/deadsnakes-ubuntu-ppa-jammy.list.disabled \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl espeak-ng ffmpeg fonts-noto-cjk git git-lfs \
      libgl1 libglib2.0-0 libsndfile1 ninja-build sox tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Each heavyweight stack is isolated, but inherits the CUDA-enabled Torch from
# the pinned vLLM base image. This keeps one deliverable image without copying
# the multi-gigabyte Torch/CUDA stack into every virtual environment. Separate
# layers make a transient source download retryable without rebuilding every
# previously completed runtime.
COPY docker/controller-requirements.txt /tmp/controller-requirements.txt
RUN uv venv --python /usr/bin/python3 /opt/venvs/controller \
    && uv pip install --python /opt/venvs/controller/bin/python -r /tmp/controller-requirements.txt

COPY docker/image-requirements.txt /tmp/image-requirements.txt
RUN uv venv --system-site-packages --python /usr/bin/python3 /opt/venvs/image \
    && uv pip install --python /opt/venvs/image/bin/python --no-deps -r /tmp/image-requirements.txt \
    && uv pip install --python /opt/venvs/image/bin/python \
      "huggingface-hub==0.36.0"

COPY docker/audio-requirements.txt /tmp/audio-requirements.txt
RUN uv venv --system-site-packages --python /usr/bin/python3 /opt/venvs/audio \
    && uv pip install --python /opt/venvs/audio/bin/python --no-deps -r /tmp/audio-requirements.txt \
    && uv pip install --python /opt/venvs/audio/bin/python \
      "huggingface-hub==0.36.0" \
      "dynet38==2.2" \
      "librosa==0.11.0" \
      "onnxruntime==1.24.3" \
      "qwen-omni-utils==0.0.9" \
      "soynlp==0.0.493"

COPY docker/h3-requirements.txt /tmp/h3-requirements.txt
# The base image already supplies its matched CUDA 12.9 Torch trio. H3's
# Python packages are installed without recursively replacing that stack.
RUN uv venv --system-site-packages --python /usr/bin/python3 /opt/venvs/h3 \
    && uv pip install --python /opt/venvs/h3/bin/python --no-deps \
      -r /tmp/h3-requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY runtime ./runtime
ENV NOVEL_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
RUN uv pip install --python /opt/venvs/controller/bin/python /app

# MiniMax H3 runs through the pinned ComfyUI source snapshot. Model weights
# remain mounted at /models/minimax-h3 and are never copied into the image.
COPY vendor/ComfyUI /opt/ComfyUI
COPY runtime/comfyui_custom_nodes/novel_manga_h3_audio_drive \
     /opt/ComfyUI/custom_nodes/novel_manga_h3_audio_drive
RUN PYTHONPATH=/opt/ComfyUI /opt/venvs/h3/bin/python -c \
      "import torch, torchaudio, aiohttp, av, comfy.nested_tensor; from comfyui_workflow_templates import iter_templates; from custom_nodes.novel_manga_h3_audio_drive import VRGDG_MiniMaxH3AudioDrive; assert torch.version.cuda == '12.9'; assert next(iter(iter_templates()), None) is not None"
RUN chmod 0755 /app/runtime/entrypoint.sh /app/runtime/*.py

RUN useradd --create-home --uid 10001 runner \
    && mkdir -p /input /output /models /run/novel-manga \
    && chown -R runner:runner /app /input /output /run/novel-manga

LABEL org.opencontainers.image.version="0.12.0" \
      io.novel-manga.comfyui-revision="6f7cd7fceaaf60d2669b554936394a7412c6fde5" \
      io.novel-manga.comfyui-patch="headless-template-gallery-warning" \
      io.novel-manga.h3-audio-drive-license="AGPL-3.0"

# Mounted checkpoints are commonly owned by a host-side UID and may be
# read-only. Running the submitted SUT as root avoids making the mount contract
# depend on a particular host UID; generated outputs remain confined to
# /output.
USER root
EXPOSE 80

ENTRYPOINT ["/usr/bin/tini", "--", "/app/runtime/entrypoint.sh"]
