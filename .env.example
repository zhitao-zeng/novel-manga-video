# .env manifest: required / optional / deprecated. Never commit credentials;
# inject real keys at runtime. doctor.py flags any deprecated name it finds
# in the live .env (names only, values are never read into reports).

# ============================================================================
# 1. REQUIRED - one episode run fails without these.
# ============================================================================

# --- PhanRouter media service (image + video generation) ---
PHANROUTER_BASE_URL=https://cloud.phanthy.com/phanrouter  # PhanRouter gateway: every image/video submission
PHANROUTER_API_KEY=                                       # PhanRouter key: video submissions (and image, unless overridden below)
PHANROUTER_IMAGE_MODEL=gpt-image-2                        # PhanRouter image model name
PHANROUTER_VIDEO_MODEL=sd2.5                              # PhanRouter video model name

# --- Text endpoints (planning, H3 prompts, second review) ---
QWEN38_LOCAL_BASE_URL=http://127.0.0.1:18120/v1           # local Qwen3.8 vLLM (comma-separate several instances); doctor probes each
GPU81_QWEN_API_KEY=                                       # gpu81 Qwen3.8-Flash-Next endpoint key (flashnext preset)
GPU52_DEEPSEEK_API_KEY=                                   # gpu52 DeepSeek-V4.1-Flash endpoint key (deepseek preset)

# --- Production planner: local command adapter (bundled DeepSeek adapter) ---
NOVEL_PLANNER_BACKEND=command                             # planner runs through DEEPSEEK_LOCAL_ROUTER_URL
DEEPSEEK_LOCAL_ROUTER_URL=http://127.0.0.1:4000           # local DeepSeek router service
DEEPSEEK_LOCAL_ROUTER_KEY=                                # key for that router
DEEPSEEK_LOCAL_MODEL=deepseek-local                       # model name the router serves

# --- ASR evidence: subtitles + the three native-dialogue hard checks ---
NOVEL_SENSEVOICE_MODEL_DIR=                               # SenseVoice model dir (model.int8.onnx + tokens.txt); doctor verifies the files

# --- Output layout ---
NOVEL_OUTPUT_ROOT=/output                                 # where finished episodes land
NOVEL_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc  # subtitle/cover font
NOVEL_PROVIDER=phanrouter                                 # media provider selection
NOVEL_MAX_UPLOAD_BYTES=52428800                           # upload cap for reference assets

# ============================================================================
# 2. OPTIONAL - switches and tuning; safe defaults when unset.
# ============================================================================

NOVEL_LOCAL_QWEN_IMAGE_URL=                               # local Qwen image service; doctor probes /health only when set
NOVEL_PROBE=1                                             # cost probe switch; set 0 to disable (one 4s probe per book per day)
PHANROUTER_IMAGE_API_KEY=                                 # separate PhanRouter image key; falls back to PHANROUTER_API_KEY
PHANROUTER_VIDEO_KEY_VAR=                                 # name of the variable holding the video key; defaults to PHANROUTER_API_KEY
PHANROUTER_REFERENCE_ASSETS=0                             # 1 enables the PhanRouter asset library; doctor probes it only then
PHANROUTER_ASSET_GROUP_ID=                                # asset group for the library (required when REFERENCE_ASSETS=1)
NOVEL_ASR_COMMAND=                                        # external ASR command adapter; unset uses the bundled SenseVoice path

NOVEL_INTRO_SECONDS=0
PHANROUTER_INLINE_REFERENCE_IMAGES=0
NOVEL_REUSE_EXISTING_ASSETS=0
NOVEL_REUSE_EXISTING_KEYFRAMES=0
NOVEL_FINAL_AUDIO_POLICY=native_dialogue
NOVEL_VIDEO_MAX_SECONDS=14
NOVEL_PLANNER_MAX_REVISIONS=2
NOVEL_PLANNER_BEAT_MAX_RETRIES=1
NOVEL_PLANNING_TIMEOUT_SECONDS=600
DEEPSEEK_LOCAL_TIMEOUT=900
NOVEL_REQUEST_TIMEOUT=180
NOVEL_ADMISSION_MODE=production
NOVEL_VIDEO_WORKERS=2
NOVEL_MAX_UNIT_ATTEMPTS=2
NOVEL_MAX_SUBTITLE_CPS=15

# ============================================================================
# 3. DEPRECATED - dead, do not use. doctor reports these names in .env.
#    Kept here only so an old .env can be cleaned up; never set them.
# ============================================================================

# NOVEL_TTS_COMMAND=      # old TTS backend - dead, do not use; final audio is native dialogue, there is no TTS stage
# NOVEL_VOICE_MAP_JSON=   # old TTS voice map - dead, do not use; died with NOVEL_TTS_COMMAND
# NOVEL_LLM_BASE_URL=     # dead, do not use: pointed at the retired endpoint 127.0.0.1:18012
# NOVEL_LLM_API_KEY=      # dead, do not use: paired with the dead NOVEL_LLM_BASE_URL
# NOVEL_LLM_MODEL=        # dead, do not use: paired with the dead NOVEL_LLM_BASE_URL
# PHANROUTER_SD25_KEY=    # dead, do not use: sd2.5 pilot key slot; PHANROUTER_API_KEY is the live one
