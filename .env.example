# Never commit credentials. Inject them at runtime.

# Leaderboard HTTP service. One novel job at a time leaves two-way video
# concurrency available inside the job on the 4-core/A100 submission host.
NOVEL_OUTPUT_ROOT=/output
NOVEL_UPLOAD_ROOT=/output/.uploads
NOVEL_JOB_ROOT=/output/.jobs
NOVEL_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc
NOVEL_PROVIDER=phanrouter
NOVEL_JOB_WORKERS=1
NOVEL_MAX_UPLOAD_BYTES=52428800

# Media provider: phanrouter
PHANROUTER_BASE_URL=https://cloud.phanthy.com/phanrouter
PHANROUTER_API_KEY=
PHANROUTER_IMAGE_MODEL=gpt-image-2
PHANROUTER_VIDEO_MODEL=sd2.5
PHANROUTER_INLINE_REFERENCE_IMAGES=0
NOVEL_REUSE_EXISTING_ASSETS=0
NOVEL_REUSE_EXISTING_KEYFRAMES=0

# Planner: auto | deterministic | openai-compatible | command
NOVEL_PLANNER_BACKEND=auto
NOVEL_PLANNER_COMMAND=
NOVEL_PLANNER_MAX_REVISIONS=2
NOVEL_LLM_BASE_URL=
NOVEL_LLM_API_KEY=
NOVEL_LLM_MODEL=gpt-5-mini
NOVEL_LLM_MAX_TOKENS=8192
# Set to 1 only for a vLLM/Qwen endpoint that accepts chat_template_kwargs.
NOVEL_LLM_DISABLE_THINKING=0
NOVEL_REQUEST_TIMEOUT=180

# Media provider: command (used with NOVEL_PROVIDER=command)
NOVEL_IMAGE_COMMAND=
# Local Z-Image/Qwen-Edit prompt compiler. native-v5 repaints legacy PBR/game-CG
# references into restrained cinematic-realism donghua frames; native-v4 remains
# available for exact rollback and controlled comparisons.
NOVEL_LOCAL_IMAGE_PROMPT_POLICY=native-v5
# keyframe is the safe default. The opt-in H3 mode skips per-shot Qwen edits
# only for visual groups with exactly one visible character plus one location.
NOVEL_LOCAL_VISUAL_STRATEGY=keyframe
NOVEL_VIDEO_COMMAND=
NOVEL_MODEL_LIFECYCLE_COMMAND=
NOVEL_REQUIRE_LOCAL_MODELS=0
NOVEL_MODEL_SUPERVISOR_URL=http://127.0.0.1:18090
# Audio-driven video backends such as local MiniMax H3 require an input track
# for every shot. The Core generates a dialogue-only/silent timing driver.
NOVEL_VIDEO_REQUIRES_AUDIO=0
NOVEL_VIDEO_MAX_SECONDS=14
NOVEL_MINIMAX_H3_URL=http://127.0.0.1:18100
NOVEL_MINIMAX_H3_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors
NOVEL_MINIMAX_H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_int8_convrot.safetensors
NOVEL_MINIMAX_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
NOVEL_MINIMAX_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
NOVEL_MINIMAX_H3_WIDTH=480
NOVEL_MINIMAX_H3_HEIGHT=832
NOVEL_MINIMAX_H3_STEPS=20
NOVEL_MINIMAX_H3_SCHEDULER=simple
NOVEL_MINIMAX_H3_REF_IMAGE_SIZE=match

# TTS: generic command, OpenAI-compatible endpoint, or mounted sherpa/VITS model.
NOVEL_TTS_COMMAND=
NOVEL_TTS_BASE_URL=
NOVEL_TTS_API_KEY=
NOVEL_TTS_MODEL=gpt-4o-mini-tts
NOVEL_TTS_VOICE=alloy
NOVEL_TTS_SPEED=
NOVEL_TTS_NARRATION_SPEED=
NOVEL_TTS_DIALOGUE_SPEED=
NOVEL_VOICE_MAP_JSON={}
NOVEL_LOCAL_TTS_PYTHON=
NOVEL_LOCAL_TTS_MODEL_DIR=
NOVEL_LOCAL_TTS_MODEL_FILE=model.onnx
NOVEL_LOCAL_TTS_SID=0

# Production evidence backends. ASR is mandatory; alignment is optional.
NOVEL_ALIGN_COMMAND=
NOVEL_ASR_COMMAND=

NOVEL_ADMISSION_MODE=production
NOVEL_VIDEO_WORKERS=2
NOVEL_MAX_UNIT_ATTEMPTS=2
NOVEL_MAX_ASR_CER=0.12
NOVEL_MAX_TURN_CER=0.35
NOVEL_MAX_SUBTITLE_CPS=15
